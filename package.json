  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "bridge": "tsx src/bridge/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test:ui": "playwright test",
    "check:safe": "node scripts/check-safe.mjs"
  },
  "dependencies": {
    "@alicloud/dyvmsapi20170525": "4.5.0",
    "@alicloud/openapi-core": "1.0.8",
